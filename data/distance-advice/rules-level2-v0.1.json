{"level":2,"rules":[{"id":"L2-01","category":"TRAFFIC","priority":58,"when":{"density_tag":"VERY_CLOSE_HEAVY","traffic":"narrow"},"advice":"近接POI周辺では停止位置を絞り、幅のある場所へ参加者を流しましょう。","facts_used":["under20_ratio","traffic"],"behavior_tags":["REDUCE_STOPS","MOVE_TO_WIDER_AREA"]},{"id":"L2-02","category":"TRAFFIC","priority":62,"when":{"density_tag":"VERY_CLOSE_HEAVY","traffic":"careful"},"advice":"近接POIでの滞在より、一般利用者の通行を優先した案内を意識しましょう。","facts_used":["under20_ratio","traffic"],"behavior_tags":["PRIORITIZE_PUBLIC_FLOW","REDUCE_DWELL"]},{"id":"L2-03","category":"FLOW","priority":55,"when":{"density_tag":"VERY_CLOSE_HEAVY","circulation":true},"advice":"近接地点に留めず、回遊できる環境を活かして周辺へ参加者を流しましょう。","facts_used":["under20_ratio","circulation"],"behavior_tags":["KEEP_FLOWING","USE_CIRCULATION"]},{"id":"L2-04","category":"WAITING","priority":64,"when":{"density_tag":"VERY_CLOSE_HEAVY","waiting":false},"advice":"密集しているPOI周辺を待機場所にせず、到着後は早めに移動しましょう。","facts_used":["under20_ratio","waiting"],"behavior_tags":["NO_WAIT_AT_DENSE_POI","MOVE_AFTER_ARRIVAL"]},{"id":"L2-05","category":"GATHERING","priority":52,"when":{"density_tag":"VERY_CLOSE_HEAVY","plaza":true},"advice":"集合や説明は広場で行い、密集POIそのものを集合地点にしない方法があります。","facts_used":["under20_ratio","plaza"],"behavior_tags":["PLAZA_AS_HUB","SEPARATE_GATHERING_FROM_POI"]},{"id":"L2-06","category":"FLOW","priority":50,"when":{"density_tag":"MID_CLOSE_HEAVY","circulation":true},"advice":"20〜30m帯のPOI群を一つの回遊区間として扱うと案内しやすくなります。","facts_used":["between20_30_ratio","circulation"],"behavior_tags":["USE_CIRCULATION","TREAT_AS_ROUTE_SECTION"]},{"id":"L2-07","category":"TRAFFIC","priority":56,"when":{"density_tag":"MID_CLOSE_HEAVY","traffic":"narrow"},"advice":"狭い区間ではPOIごとの停止を減らし、一まとまりとして通過する方法もあります。","facts_used":["between20_30_ratio","traffic"],"behavior_tags":["REDUCE_STOPS","PASS_THROUGH_SECTION"]},{"id":"L2-08","category":"ROUTE","priority":48,"when":{"density_tag":"WIDE_CLOSE_HEAVY","circulation":true},"advice":"POI間の間隔を活かして、自然に次の地点へ進めるルートを考えてみましょう。","facts_used":["between30_50_ratio","circulation"],"behavior_tags":["USE_CIRCULATION","SPREAD_ROUTE"]},{"id":"L2-09","category":"FLOW","priority":46,"when":{"density_tag":"WIDE_CLOSE_HEAVY","traffic":"easy"},"advice":"移動しやすさを活かして、参加者を順次次のPOIへ案内できます。","facts_used":["between30_50_ratio","traffic"],"behavior_tags":["KEEP_FLOWING","SEQUENTIAL_GUIDANCE"]},{"id":"L2-10","category":"ROUTE","priority":51,"when":{"density_tag":"MIXED_CLOSE","circulation":true},"advice":"距離の異なるPOIをつなぎ、特定地点だけに集中しない回遊ルートを作りましょう。","facts_used":["under20_ratio","between20_30_ratio","between30_50_ratio","circulation"],"behavior_tags":["USE_CIRCULATION","DISTRIBUTE_FLOW"]},{"id":"L2-11","category":"GATHERING","priority":48,"when":{"density_tag":"MIXED_CLOSE","plaza":true},"advice":"広場を起点に、複数方向へ参加者を送り出す運用も考えられます。","facts_used":["under20_ratio","between20_30_ratio","between30_50_ratio","plaza"],"behavior_tags":["PLAZA_AS_HUB","DISTRIBUTED_START"]},{"id":"L2-12","category":"GATHERING","priority":59,"when":{"feature_tags":["CLOSE_MANY"],"plaza":false},"advice":"一斉集合よりも、参加者が分散して開始できる方法を検討しましょう。","facts_used":["under50_count","existing_poi_count","plaza"],"behavior_tags":["DISTRIBUTED_START"]},{"id":"L2-13","category":"WAITING","priority":61,"when":{"feature_tags":["CLOSE_MANY"],"waiting":false},"advice":"待機を前提にせず、到着から移動開始までを短くすると扱いやすくなります。","facts_used":["under50_count","existing_poi_count","waiting"],"behavior_tags":["NO_WAITING","MOVE_AFTER_ARRIVAL"]},{"id":"L2-14","category":"WAITING","priority":57,"when":{"traffic":"narrow","waiting":true},"advice":"待機する人と通行する人が重ならない位置に待機場所を設定しましょう。","facts_used":["traffic","waiting"],"behavior_tags":["SEPARATE_WAITING_FROM_TRAFFIC"]},{"id":"L2-15","category":"GATHERING","priority":61,"when":{"traffic":"careful","plaza":true},"advice":"集合や説明を広場側で行い、通行エリアに参加者を留めないようにしましょう。","facts_used":["traffic","plaza"],"behavior_tags":["PLAZA_AS_HUB","PRIORITIZE_PUBLIC_FLOW"]},{"id":"L2-16","category":"GATHERING","priority":63,"when":{"plaza":false,"waiting":false},"advice":"全員を同じ場所へ集めず、到着した人から順番に始める方法があります。","facts_used":["plaza","waiting"],"behavior_tags":["DISTRIBUTED_START","ROLLING_START"]},{"id":"L2-17","category":"FLOW","priority":58,"when":{"circulation":false,"waiting":false},"advice":"長時間その場に留まらず、出発タイミングをずらす運用も検討しましょう。","facts_used":["circulation","waiting"],"behavior_tags":["REDUCE_DWELL","STAGGER_START"]},{"id":"L2-18","category":"ROUTE","priority":52,"when":{"circulation":false,"plaza":true},"advice":"広場を拠点にして、周辺へ往復するシンプルな動線を組み立てられます。","facts_used":["circulation","plaza"],"behavior_tags":["PLAZA_AS_HUB","OUT_AND_BACK_ROUTE"]},{"id":"L2-19","category":"ROUTE","priority":45,"when":{"circulation":true,"waiting":true},"advice":"待機場所をハブとして利用し、周辺を巡って戻る運用ができます。","facts_used":["circulation","waiting"],"behavior_tags":["WAITING_AS_HUB","USE_CIRCULATION"]},{"id":"L2-20","category":"FLOW","priority":42,"when":{"density_tag":"FEW_CLOSE","traffic":"easy"},"advice":"近接対策を複雑にしすぎず、通常の移動しやすい案内を中心に考えられます。","facts_used":["under50_count","traffic"],"behavior_tags":["KEEP_SIMPLE","NORMAL_FLOW"]}]}