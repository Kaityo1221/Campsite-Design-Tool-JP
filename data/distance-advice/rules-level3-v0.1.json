{"level":3,"rules":[{"id":"L3-01","category":"FLOW","priority":82,"when":{"density_tag":"VERY_CLOSE_HEAVY","circulation":true,"waiting":false},"advice":"近接POIでは長く停止せず、回遊を使って到着した参加者から順次周辺へ流しましょう。","facts_used":["under20_ratio","circulation","waiting"],"behavior_tags":["REDUCE_DWELL","KEEP_FLOWING","USE_CIRCULATION"]},{"id":"L3-02","category":"TRAFFIC","priority":86,"when":{"density_tag":"VERY_CLOSE_HEAVY","traffic":"narrow","waiting":false},"advice":"密集地点と狭い通路が重なるため、その場所を待機地点にせず、幅のある場所へ案内しましょう。","facts_used":["under20_ratio","traffic","waiting"],"behavior_tags":["NO_WAIT_IN_NARROW_AREA","MOVE_TO_WIDER_AREA"]},{"id":"L3-03","category":"GATHERING","priority":84,"when":{"density_tag":"VERY_CLOSE_HEAVY","plaza":true,"waiting":true},"advice":"集合は広場・待機場所へ分離し、近接POIはプレイする場所として扱いましょう。","facts_used":["under20_ratio","plaza","waiting"],"behavior_tags":["PLAZA_AS_HUB","SEPARATE_GATHERING_FROM_POI"]},{"id":"L3-04","category":"FLOW","priority":88,"when":{"density_tag":"VERY_CLOSE_HEAVY","plaza":false,"circulation":true},"advice":"集合地点を固定しすぎず、近接POIエリアを通過しながら巡る運用が向いています。","facts_used":["under20_ratio","plaza","circulation"],"behavior_tags":["DISTRIBUTED_START","USE_CIRCULATION","PASS_THROUGH_SECTION"]},{"id":"L3-05","category":"TRAFFIC","priority":89,"when":{"density_tag":"VERY_CLOSE_HEAVY","traffic":"careful","circulation":true},"advice":"通行を優先し、近接POIでは停止を最小限にして回遊ルートへ案内しましょう。","facts_used":["under20_ratio","traffic","circulation"],"behavior_tags":["PRIORITIZE_PUBLIC_FLOW","REDUCE_STOPS","USE_CIRCULATION"]},{"id":"L3-06","category":"GATHERING","priority":87,"when":{"density_tag":"VERY_CLOSE_HEAVY","plaza":false,"waiting":false},"advice":"大人数を一か所に集める前提を外し、順次スタートできる形を考えましょう。","facts_used":["under20_ratio","plaza","waiting"],"behavior_tags":["DISTRIBUTED_START","ROLLING_START"]},{"id":"L3-07","category":"WAITING","priority":80,"when":{"density_tag":"VERY_CLOSE_HEAVY","traffic":"narrow","waiting":true},"advice":"待機場所が使えるなら、近接POIや狭い通路ではなく、確認済みの待機地点へ人を集約しましょう。","facts_used":["under20_ratio","traffic","waiting"],"behavior_tags":["WAITING_AS_HUB","NO_WAIT_IN_NARROW_AREA"]},{"id":"L3-08","category":"FLOW","priority":78,"when":{"density_tag":"MID_CLOSE_HEAVY","circulation":true,"waiting":false},"advice":"POI群を一つの回遊区間として使い、各POIで個別に待機する運用は避けましょう。","facts_used":["between20_30_ratio","circulation","waiting"],"behavior_tags":["USE_CIRCULATION","NO_WAITING","TREAT_AS_ROUTE_SECTION"]},{"id":"L3-09","category":"TRAFFIC","priority":83,"when":{"density_tag":"MID_CLOSE_HEAVY","traffic":"narrow","circulation":true},"advice":"狭い区間では立ち止まる回数を減らし、まとまった区間として通過すると流れを作りやすくなります。","facts_used":["between20_30_ratio","traffic","circulation"],"behavior_tags":["REDUCE_STOPS","PASS_THROUGH_SECTION","KEEP_FLOWING"]},{"id":"L3-10","category":"GATHERING","priority":75,"when":{"density_tag":"MID_CLOSE_HEAVY","plaza":true,"circulation":true},"advice":"広場で案内した後、20〜30m帯のPOI群へ参加者を送り出す流れを作れます。","facts_used":["between20_30_ratio","plaza","circulation"],"behavior_tags":["PLAZA_AS_HUB","USE_CIRCULATION"]},{"id":"L3-11","category":"ROUTE","priority":72,"when":{"density_tag":"WIDE_CLOSE_HEAVY","traffic":"easy","circulation":true},"advice":"比較的間隔のあるPOIを活かし、止まる場所と移動する場所が自然に分かれるルートを作れます。","facts_used":["between30_50_ratio","traffic","circulation"],"behavior_tags":["SPREAD_ROUTE","USE_CIRCULATION"]},{"id":"L3-12","category":"FLOW","priority":74,"when":{"density_tag":"WIDE_CLOSE_HEAVY","circulation":true,"waiting":false},"advice":"一か所に待機させず、POI間の距離を使って参加者を分散させましょう。","facts_used":["between30_50_ratio","circulation","waiting"],"behavior_tags":["DISTRIBUTE_FLOW","NO_WAITING"]},{"id":"L3-13","category":"ROUTE","priority":76,"when":{"density_tag":"MIXED_CLOSE","circulation":true,"plaza":true},"advice":"広場を起点に、近いPOIと離れたPOIを組み合わせた複数ルートを作れます。","facts_used":["under20_ratio","between20_30_ratio","between30_50_ratio","circulation","plaza"],"behavior_tags":["PLAZA_AS_HUB","MULTI_ROUTE"]},{"id":"L3-14","category":"FLOW","priority":79,"when":{"density_tag":"MIXED_CLOSE","circulation":true,"waiting":false},"advice":"距離帯が混在しているため、参加者を複数方向へ流して特定地点への集中を避けましょう。","facts_used":["under20_ratio","between20_30_ratio","between30_50_ratio","circulation","waiting"],"behavior_tags":["DISTRIBUTE_FLOW","USE_CIRCULATION"]},{"id":"L3-15","category":"TRAFFIC","priority":85,"when":{"traffic":"careful","plaza":false,"waiting":false},"advice":"通行エリアで人を待たせないよう、集合時間を固定しすぎず順次行動を始める形が扱いやすいです。","facts_used":["traffic","plaza","waiting"],"behavior_tags":["PRIORITIZE_PUBLIC_FLOW","ROLLING_START","NO_WAITING"]},{"id":"L3-16","category":"GATHERING","priority":81,"when":{"traffic":"narrow","plaza":true,"waiting":false},"advice":"狭い通路では集合せず、説明や待ち合わせは広場側へ寄せましょう。","facts_used":["traffic","plaza","waiting"],"behavior_tags":["PLAZA_AS_HUB","NO_GATHER_IN_NARROW_AREA"]},{"id":"L3-17","category":"WAITING","priority":77,"when":{"traffic":"narrow","plaza":false,"waiting":true},"advice":"待機場所を明確に決め、狭い通路に参加者が広がらないよう誘導しましょう。","facts_used":["traffic","plaza","waiting"],"behavior_tags":["WAITING_AS_HUB","NO_WAIT_IN_NARROW_AREA"]},{"id":"L3-18","category":"FLOW","priority":83,"when":{"traffic":"narrow","circulation":true,"waiting":false},"advice":"通路上では立ち止まらず、参加者を回遊ルートへ継続的に流す運用が向いています。","facts_used":["traffic","circulation","waiting"],"behavior_tags":["NO_STOP_IN_NARROW_AREA","KEEP_FLOWING","USE_CIRCULATION"]},{"id":"L3-19","category":"ROUTE","priority":80,"when":{"circulation":false,"plaza":true,"waiting":true},"advice":"広場と待機場所を拠点にして、必要な地点へ往復するシンプルな動線が作れます。","facts_used":["circulation","plaza","waiting"],"behavior_tags":["PLAZA_AS_HUB","WAITING_AS_HUB","OUT_AND_BACK_ROUTE"]},{"id":"L3-20","category":"FLOW","priority":84,"when":{"circulation":false,"plaza":false,"waiting":false},"advice":"長時間滞在を前提にせず、参加者の到着・行動・退出を短いサイクルで回しましょう。","facts_used":["circulation","plaza","waiting"],"behavior_tags":["REDUCE_DWELL","SHORT_CYCLE_FLOW"]},{"id":"L3-21","category":"GATHERING","priority":74,"when":{"circulation":true,"plaza":true,"waiting":false},"advice":"広場で集合後、すぐに回遊を開始する流れを作ると待機時間を減らせます。","facts_used":["circulation","plaza","waiting"],"behavior_tags":["PLAZA_AS_HUB","USE_CIRCULATION","REDUCE_WAIT_TIME"]},{"id":"L3-22","category":"GATHERING","priority":73,"when":{"circulation":true,"plaza":false,"waiting":true},"advice":"待機地点を小さなハブとして使い、そこから各ルートへ分散させましょう。","facts_used":["circulation","plaza","waiting"],"behavior_tags":["WAITING_AS_HUB","DISTRIBUTE_FLOW"]},{"id":"L3-23","category":"ROUTE","priority":71,"when":{"density_tag":"NO_CLOSE","circulation":true,"traffic":"easy"},"advice":"POI間の移動を活かし、拠点全体を広く巡るルートを組み立てやすい環境です。","facts_used":["under50_count","circulation","traffic"],"behavior_tags":["SPREAD_ROUTE","USE_CIRCULATION"]},{"id":"L3-24","category":"GATHERING","priority":69,"when":{"density_tag":"FEW_CLOSE","plaza":true,"waiting":true},"advice":"広場や待機場所を中心にしたシンプルな集合・解散動線で十分運用できます。","facts_used":["under50_count","plaza","waiting"],"behavior_tags":["PLAZA_AS_HUB","WAITING_AS_HUB","KEEP_SIMPLE"]},{"id":"L3-25","category":"TRAFFIC","priority":82,"when":{"feature_tags":["CLOSE_MANY"],"traffic":"careful","plaza":true},"advice":"POI周辺での説明を減らし、まとまった案内は広場で行うと通行への影響を抑えやすくなります。","facts_used":["under50_count","existing_poi_count","traffic","plaza"],"behavior_tags":["PLAZA_AS_HUB","PRIORITIZE_PUBLIC_FLOW","REDUCE_STOPS"]},{"id":"L3-26","category":"ROUTE","priority":66,"when":{"density_tag":"NO_CLOSE","plaza":false,"circulation":false,"waiting":true},"advice":"近接POIはありません。待機場所を小さな拠点として使い、必要な地点へシンプルに往復する運用が考えられます。","facts_used":["under50_count","plaza","circulation","waiting"],"behavior_tags":["WAITING_AS_HUB","OUT_AND_BACK_ROUTE","KEEP_SIMPLE"]},{"id":"L3-27","category":"TRAFFIC","priority":78,"when":{"density_tag":"NO_CLOSE","traffic":"careful","plaza":false,"circulation":false,"waiting":true},"advice":"待機場所は活用しつつ、通行エリアに人が広がらない位置を選び、移動はシンプルにまとめましょう。","facts_used":["under50_count","traffic","plaza","circulation","waiting"],"behavior_tags":["WAITING_AS_HUB","PRIORITIZE_PUBLIC_FLOW","KEEP_SIMPLE"]},{"id":"L3-28","category":"GATHERING","priority":76,"when":{"density_tag":"FEW_CLOSE","traffic":"careful","plaza":false,"circulation":false,"waiting":true},"advice":"近接POIは少数です。待機場所を集合の基点にし、通行を妨げない範囲で短い往復動線にまとめましょう。","facts_used":["under50_count","traffic","plaza","circulation","waiting"],"behavior_tags":["WAITING_AS_HUB","PRIORITIZE_PUBLIC_FLOW","KEEP_SIMPLE"]}]}