{
  "manifest_version": 3,
  "name": "Campsite Bridge",
  "version": "0.1.0",
  "description": "Wayfarer MapのPOIをCampsite Design Toolへ安全に受け渡します。",
  "permissions": [],
  "host_permissions": [
    "https://wayfarer.scopely.com/*",
    "https://wayfarer.nianticlabs.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://wayfarer.scopely.com/*",
        "https://wayfarer.nianticlabs.com/*"
      ],
      "js": ["wayfarer-map-adapter.js", "wayfarer-display-owner.js", "wayfarer-deck-compat.js", "poi-parser.js", "poi-classifier.js", "poi-reference-layer.js", "poi-diagnostics.js", "bridge-v1-exporter.js", "page-collector.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://wayfarer.scopely.com/*",
        "https://wayfarer.nianticlabs.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
