{
  "manifest_version": 3,
  "name": "Campsite Bridge - PC TEST",
  "version": "0.1.0",
  "description": "Wayfarerで設計範囲を決め、範囲内のPOIをCampsiteへ送るPC実機確認用Bridge。",
  "permissions": [],
  "host_permissions": [
    "https://wayfarer.scopely.com/*",
    "https://wayfarer.nianticlabs.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://wayfarer.scopely.com/*",
        "https://wayfarer.nianticlabs.com/*"
      ],
      "js": [
        "wayfarer-poi-visibility.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://wayfarer.scopely.com/*",
        "https://wayfarer.nianticlabs.com/*"
      ],
      "js": [
        "wayfarer-map-adapter.js",
        "wayfarer-display-owner.js",
        "wayfarer-deck-compat.js",
        "wayfarer-polygon-controller.js",
        "wayfarer-acquisition-engine.js",
        "poi-parser.js",
        "poi-classifier.js",
        "poi-reference-layer.js",
        "poi-diagnostics.js",
        "bridge-v1-exporter.js",
        "page-collector.js",
        "wm1-live-verifier.js",
        "wayfarer-observation-zone.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://wayfarer.scopely.com/*",
        "https://wayfarer.nianticlabs.com/*"
      ],
      "js": [
        "content.js",
        "polygon-ui.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://kaityo1221.github.io/Campsite-Design-Tool-JP/creative/*"
      ],
      "js": [
        "creative-wm3c-test-runtime.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
