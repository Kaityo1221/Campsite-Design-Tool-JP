{
  "manifest_version": 3,
  "name": "Campsite Bridge - WM-3B-2 TEST",
  "version": "0.1.0",
  "description": "WM-3B-2実機確認用。Wayfarer Mapと公開CreativeのPolygon観察通信を検証します。",
  "permissions": [],
  "host_permissions": [
    "https://wayfarer.scopely.com/*",
    "https://wayfarer.nianticlabs.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://wayfarer.scopely.com/*",
        "https://wayfarer.nianticlabs.com/*"
      ],
      "js": [
        "wayfarer-map-adapter.js",
        "wayfarer-display-owner.js",
        "wayfarer-deck-compat.js",
        "wayfarer-polygon-controller.js",
        "wayfarer-acquisition-engine.js",
        "poi-parser.js",
        "poi-classifier.js",
        "poi-reference-layer.js",
        "poi-diagnostics.js",
        "bridge-v1-exporter.js",
        "page-collector.js",
        "wm1-live-verifier.js",
        "wayfarer-observation-zone.js",
        "wm3-observe-controller.js",
        "wm3b-tab-link.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://wayfarer.scopely.com/*",
        "https://wayfarer.nianticlabs.com/*"
      ],
      "js": [
        "content.js",
        "polygon-ui.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://kaityo1221.github.io/Campsite-Design-Tool-JP/creative/*"
      ],
      "js": [
        "creative-wm3b2b-test-injector.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
